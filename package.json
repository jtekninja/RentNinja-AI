{
  "name": "rentninja-ai",
  "version": "1.0.0",
  "private": true,
  "description": "RentNinja AI - multi-tenant tenant screening SaaS built with Next.js, MongoDB Atlas, Auth.js, and Stripe-ready billing.",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "prebuild": "node scripts/clean-next-build.js",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx scripts/seed.ts",
    "seed:test-admins": "tsx scripts/seed-test-admins.ts"
  },
  "dependencies": {
    "@auth/mongodb-adapter": "^3.11.2",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "mongodb": "^6.21.0",
    "mongoose": "^9.5.0",
    "next": "^16.2.4",
    "next-auth": "^5.0.0-beta.31",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "stripe": "^22.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.4",
    "mongodb-memory-server": "^11.1.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
