# ─── Database ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/rentninja-ai?retryWrites=true&w=majority
MONGODB_DB=rentninja-ai

# ─── Authentication ───────────────────────────────────────────────────────────
# REQUIRED — app will refuse to start without this.
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TRUST_HOST=true

# ─── App URL ──────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── AI ───────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── Maps ─────────────────────────────────────────────────────────────────────
MAPBOX_ACCESS_TOKEN=

# ─── Stripe Billing ───────────────────────────────────────────────────────────
# All three are required for billing features to work.
# STRIPE_WEBHOOK_SECRET is generated by the Stripe CLI or dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=